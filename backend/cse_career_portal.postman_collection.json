{
  "info": {
    "name": "CSE Career Portal API Collection (VidyaPath)",
    "_postman_id": "c8fa3260-19ab-48d5-b6fe-9289d023b102",
    "description": "Exhaustive API collection for CSE Career Portal backend covering Authentication, Roadmap, Projects, Interviews, Books, Courses, YouTube, Notes, Hackathons, Announcements, Bookmarks, Resumes, Global Search, and Student Dashboard.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "studentToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Daksh Student\",\n  \"email\": \"student@example.com\",\n  \"password\": \"Password@123\",\n  \"college\": \"Tech Institute of Engineering\",\n  \"branch\": \"Computer Science and Engineering\",\n  \"semester\": 3,\n  \"specialization\": \"Full Stack / Software Engineering\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const jsonData = pm.response.json();",
                  "  if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('studentToken', jsonData.data.token);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@example.com\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@example.com\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["auth", "forgot-password"] }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<PASTE_RESET_TOKEN_HERE>\",\n  \"newPassword\": \"NewPassword@456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["auth", "reset-password"] }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Password@123\",\n  \"newPassword\": \"UpdatedPassword@789\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/change-password", "host": ["{{baseUrl}}"], "path": ["auth", "change-password"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "3. Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/profile", "host": ["{{baseUrl}}"], "path": ["profile"] }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bio\": \"Aspiring Software Engineer passionate about Distributed Systems and Cloud Native architectures.\",\n  \"specialization\": \"Full Stack / Software Engineering\",\n  \"semester\": 4,\n  \"graduationYear\": 2027,\n  \"github\": \"https://github.com/example-user\",\n  \"linkedin\": \"https://linkedin.com/in/example-user\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/profile", "host": ["{{baseUrl}}"], "path": ["profile"] }
          }
        }
      ]
    },
    {
      "name": "4. Roadmap",
      "item": [
        {
          "name": "Get All Roadmaps",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/roadmap", "host": ["{{baseUrl}}"], "path": ["roadmap"] }
          }
        },
        {
          "name": "Get Roadmap By Semester (1-8)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/roadmap/semester/3", "host": ["{{baseUrl}}"], "path": ["roadmap", "semester", "3"] }
          }
        },
        {
          "name": "Get Roadmap By Year (FY, SY, TY, FINAL_YEAR)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/roadmap/year/SY", "host": ["{{baseUrl}}"], "path": ["roadmap", "year", "SY"] }
          }
        },
        {
          "name": "Get User Roadmap Progress",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/roadmap/progress", "host": ["{{baseUrl}}"], "path": ["roadmap", "progress"] }
          }
        },
        {
          "name": "Save Roadmap Progress Checkpoints",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roadmapId\": \"<ROADMAP_OBJECT_ID>\",\n  \"completedItemIds\": [],\n  \"itemCheckpoints\": [\n    {\n      \"stagesCompleted\": {\n        \"learn\": true,\n        \"practice\": true,\n        \"build\": true,\n        \"test\": false,\n        \"explain\": false,\n        \"interviewReady\": false\n      }\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/roadmap/progress", "host": ["{{baseUrl}}"], "path": ["roadmap", "progress"] }
          }
        }
      ]
    },
    {
      "name": "5. Projects",
      "item": [
        {
          "name": "Get Projects (Filters, Pagination & Search)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/projects?page=1&limit=10&category=Full+Stack&difficulty=MEDIUM",
              "host": ["{{baseUrl}}"],
              "path": ["projects"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "category", "value": "Full Stack" },
                { "key": "difficulty", "value": "MEDIUM" }
              ]
            }
          }
        },
        {
          "name": "Get Project by Slug",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/projects/realtime-collaborative-code-editor", "host": ["{{baseUrl}}"], "path": ["projects", "realtime-collaborative-code-editor"] }
          }
        },
        {
          "name": "[Admin] Create Project",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Distributed Task Queue & Job Scheduler\",\n  \"category\": \"Software Engineering / System Design\",\n  \"difficulty\": \"HIGH\",\n  \"description\": \"Distributed background task scheduler with worker pools and retry policies.\",\n  \"problemStatement\": \"Modern web services require resilient asynchronous queue processing.\",\n  \"technologyStack\": {\n    \"backend\": [\"Node.js\", \"Redis\", \"BullMQ\"],\n    \"database\": [\"PostgreSQL\", \"Redis\"]\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/projects", "host": ["{{baseUrl}}"], "path": ["projects"] }
          }
        }
      ]
    },
    {
      "name": "6. Interviews",
      "item": [
        {
          "name": "Get Questions (with Category Filter)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/interviews?category=DBMS&page=1&limit=15",
              "host": ["{{baseUrl}}"],
              "path": ["interviews"],
              "query": [
                { "key": "category", "value": "DBMS" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "15" }
              ]
            }
          }
        },
        {
          "name": "Mark Question as Practiced",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/interviews/<QUESTION_ID>/complete", "host": ["{{baseUrl}}"], "path": ["interviews", "<QUESTION_ID>", "complete"] }
          }
        },
        {
          "name": "Get User Interview Progress",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/interviews/progress", "host": ["{{baseUrl}}"], "path": ["interviews", "progress"] }
          }
        }
      ]
    },
    {
      "name": "7. Learning Resources",
      "item": [
        {
          "name": "Get Books",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/books?category=DSA&level=Intermediate", "host": ["{{baseUrl}}"], "path": ["books"], "query": [{ "key": "category", "value": "DSA" }, { "key": "level", "value": "Intermediate" }] }
          }
        },
        {
          "name": "Get Courses",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/courses?provider=Coursera", "host": ["{{baseUrl}}"], "path": ["courses"], "query": [{ "key": "provider", "value": "Coursera" }] }
          }
        },
        {
          "name": "Get YouTube Resources",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/youtube?category=DSA", "host": ["{{baseUrl}}"], "path": ["youtube"], "query": [{ "key": "category", "value": "DSA" }] }
          }
        },
        {
          "name": "Get Notes & Cheat Sheets",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/resources?type=notes", "host": ["{{baseUrl}}"], "path": ["resources"], "query": [{ "key": "type", "value": "notes" }] }
          }
        }
      ]
    },
    {
      "name": "8. Hackathons & Announcements",
      "item": [
        {
          "name": "Get Hackathons",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/hackathons?status=Upcoming", "host": ["{{baseUrl}}"], "path": ["hackathons"], "query": [{ "key": "status", "value": "Upcoming" }] }
          }
        },
        {
          "name": "Get Announcements",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/announcements?priority=urgent", "host": ["{{baseUrl}}"], "path": ["announcements"], "query": [{ "key": "priority", "value": "urgent" }] }
          }
        }
      ]
    },
    {
      "name": "9. Bookmarks",
      "item": [
        {
          "name": "Get My Bookmarks",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/bookmarks", "host": ["{{baseUrl}}"], "path": ["bookmarks"] }
          }
        },
        {
          "name": "Create Bookmark",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceType\": \"Book\",\n  \"resourceId\": \"<BOOK_ID>\",\n  \"notes\": \"Review chapter 5 & 6 before mock interview\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/bookmarks", "host": ["{{baseUrl}}"], "path": ["bookmarks"] }
          }
        },
        {
          "name": "Get Bookmark Collections",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/bookmark-collections", "host": ["{{baseUrl}}"], "path": ["bookmark-collections"] }
          }
        },
        {
          "name": "Create Collection",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Final Year Placement Prep\",\n  \"description\": \"Curated list of DSA problem sets, design books, and system projects\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/bookmark-collections", "host": ["{{baseUrl}}"], "path": ["bookmark-collections"] }
          }
        }
      ]
    },
    {
      "name": "10. Resume Builder",
      "item": [
        {
          "name": "Get My Resumes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/resumes", "host": ["{{baseUrl}}"], "path": ["resumes"] }
          }
        },
        {
          "name": "Create Technical Resume",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Full Stack Software Engineer Resume\",\n  \"targetRole\": \"Software Developer\",\n  \"header\": {\n    \"fullName\": \"Daksh Developer\",\n    \"email\": \"daksh@example.com\",\n    \"githubUrl\": \"https://github.com/daksh\",\n    \"linkedinUrl\": \"https://linkedin.com/in/daksh\"\n  },\n  \"skills\": {\n    \"languages\": [\"JavaScript\", \"TypeScript\", \"Python\", \"C++\"],\n    \"frameworksAndLibraries\": [\"React\", \"Node.js\", \"Express.js\"],\n    \"databasesAndStorage\": [\"MongoDB\", \"PostgreSQL\", \"Redis\"],\n    \"toolsAndCloud\": [\"Docker\", \"AWS\", \"Git\", \"Linux\"]\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/resumes", "host": ["{{baseUrl}}"], "path": ["resumes"] }
          }
        }
      ]
    },
    {
      "name": "11. Global Search",
      "item": [
        {
          "name": "Search Across Everything",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/search?q=algorithms",
              "host": ["{{baseUrl}}"],
              "path": ["search"],
              "query": [{ "key": "q", "value": "algorithms" }]
            }
          }
        }
      ]
    },
    {
      "name": "12. Student Dashboard",
      "item": [
        {
          "name": "Get Unified Dashboard Metrics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/dashboard", "host": ["{{baseUrl}}"], "path": ["dashboard"] }
          }
        }
      ]
    }
  ]
}
